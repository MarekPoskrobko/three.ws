{
	"id": "agent-monitor",
	"status": "draft",
	"kind": "post",
	"tier": 2,
	"lane": "developer",
	"pattern": "number",
	"notBefore": "2026-09-30T00:00:00Z",
	"covers": [
		"/monitor"
	],
	"scenario": {
		"format": "square",
		"steps": [
			{
				"goto": "https://three.ws/monitor",
				"settle": 8000
			},
			{
				"read": "fleet",
				"selector": "#fleet-badge",
				"match": "/\\s*([\\d,]+)"
			},
			{
				"read": "active",
				"selector": "#fleet-badge",
				"match": "([\\d,]+)\\s*active"
			},
			{
				"scroll": 60,
				"ms": 600,
				"caption": "The public agent fleet on one board, ranked by most recent real action"
			},
			{
				"hold": 1600
			},
			{
				"type": "host",
				"into": "Search agents",
				"awaits": "/api/agents/public",
				"caption": "Search runs on the server, over names and descriptions"
			},
			{
				"hold": 1300
			},
			{
				"click": "Vera the Host",
				"awaits": "/api/agents/210e9990",
				"caption": "Pick an agent and its 3D body loads in the page"
			},
			{
				"expect": "virtual hotel concierge",
				"within": 30000
			},
			{
				"wait": 6000
			},
			{
				"hold": 1800
			},
			{
				"drag": [
					[
						0.6,
						0.55
					],
					[
						0.9,
						0.55
					]
				],
				"ms": 2400,
				"caption": "It is the agent's own avatar, live. Turn it around."
			},
			{
				"hold": 2600
			}
		]
	},
	"probes": [
		{
			"type": "scenario"
		},
		{
			"type": "api",
			"name": "the public fleet feed answers",
			"url": "https://three.ws/api/agents/public?sort=live&limit=1",
			"expect": {
				"contains": "active_total"
			}
		}
	],
	"posts": [
		{
			"text": "placeholder head",
			"media": [
				{
					"path": "public/x-media/agent-monitor/reel.mp4",
					"probe": {
						"durationSec": 12.4,
						"width": 1080,
						"height": 1080,
						"fps": 30,
						"videoCodec": "h264",
						"pixFmt": "yuv420p"
					},
					"reel": true
				}
			]
		},
		{
			"text": "placeholder reply"
		}
	],
	"claims": [],
	"mentions": {}
}
