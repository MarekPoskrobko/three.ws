			},
			{
				"click": "Make 3D things"
			},
			{
				"read": "making",
				"match": "(\\d+) of \\d+ prompts"
			},
			{
				"hold": 1200
			},
			{
				"type": "rig",
				"into": "Search prompts",
				"caption": "Or search it: rigging, avatar, embed"
			},
			{
				"hold": 1000
			},
			{
				"scroll": "Generate a rigged avatar from a description",
				"ms": 1500,
				"caption": "Each prompt names the tools to call and what to check first"
			},
			{
				"hold": 2200
			},
			{
				"click": "Copy prompt",
				"caption": "Copy it, paste it, swap the words in angle brackets"
			},
			{
				"expect": "Copied",
				"within": 5000
			},
			{
				"hold": 2600
