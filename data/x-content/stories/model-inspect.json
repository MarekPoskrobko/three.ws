{
	"id": "model-inspect",
	"status": "draft",
	"kind": "post",
	"tier": 2,
	"lane": "developer",
	"pattern": "number",
	"notBefore": "2026-09-30T00:00:00Z",
	"covers": [
		"/3d"
	],
	"scenario": {
		"format": "square",
		"hide": [
			".brand-mark-chip"
		],
		"steps": [
			{
				"goto": "https://three.ws/3d#quickstart",
				"settle": 6000,
				"caption": "A free 3D API for AI agents, over HTTP"
			},
			{
				"scroll": -64,
				"ms": 300
			},
			{
				"hold": 1500
			},
			{
				"click": "Run it live ▶",
				"awaits": "/api/3d/inspect",
				"caption": "One GET with a URL. No key, no account."
			},
			{
				"expect": "\"valid\": true"
			},
			{
				"read": "vertices",
				"match": "\"vertices\": (\\d+)"
			},
			{
				"read": "triangles",
				"match": "\"triangles\": (\\d+)"
			},
			{
				"read": "joints",
				"match": "\"joints\": (\\d+)"
			},
			{
				"read": "animations",
				"match": "\"animations\": (\\d+)"
			},
			{
				"read": "errors",
				"match": "\"numErrors\": (\\d+)"
			},
			{
				"read": "warnings",
				"match": "\"numWarnings\": (\\d+)"
			},
			{
				"hold": 2200,
				"caption": "Is the file valid, and what is inside it"
			},
			{
				"hover": {
					"selector": ".out pre"
				}
			},
			{
				"scroll": 330,
				"ms": 1800,
				"caption": "Then what to fix, most severe first"
			},
			{
				"hold": 1800
			},
			{
				"scroll": 156,
				"ms": 1200,
				"caption": "Each validator finding, with its location"
			},
			{
				"hold": 1600
			},
			{
				"hover": "Run it live ▶"
			},
			{
				"scroll": "Drag to orbit",
				"ms": 2000,
				"caption": "This is the model it just described"
			},
			{
				"scroll": 70,
				"ms": 500
			},
			{
				"hold": 3000
			}
		]
	},
	"probes": [
		{
			"type": "scenario"
		},
		{
			"type": "api",
			"name": "inspect answers for the sample model",
			"url": "https://three.ws/api/3d/inspect?url=https://three.ws/avatars/cesium-man.glb",
			"expect": {
				"json": {
					"path": "valid",
					"equals": true
				}
			}
		}
	],
	"posts": [
		{
			"text": "4,672 triangles, 19 joints, 1 animation, 0 validator errors and 1 warning. One GET request told us that about a 3D file, with no API key and no account.\n\nThe inspect endpoint is free. Hand it the address of a glTF or GLB and it answers in JSON: whether the file is valid, what is inside it, and a prioritized plan to make it smaller and faster.\n\nIt is built for AI agents that make or buy 3D mid-task and need to know what they got before they use it.",
			"media": [
				{
					"path": "public/x-media/model-inspect/reel.mp4",
					"probe": {
						"durationSec": 17.8,
						"width": 1080,
						"height": 1080,
						"fps": 30,
						"videoCodec": "h264",
						"pixFmt": "yuv420p"
					},
					"reel": true
				}
			]
		},
		{
			"text": "Send the address in a GET, or POST the file itself. The cap is 32 MB a file and 60 requests a minute.\n\nIt reports up to 10 validator findings, each with its code and where in the file it sits, beside the true totals.\n\nThe spec is OpenAPI 3.1, so an agent can read it and call this on its own: three.ws/3d"
		}
	],
