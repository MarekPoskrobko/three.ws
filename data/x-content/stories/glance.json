			{
				"scroll": 150,
				"ms": 700
			},
			{
				"type": "62e1863d-3c32-4f9b-a11c-7d89ce2bcd57",
				"into": "00000000-0000-0000-0000-000000000000",
				"awaits": "/api/glance/card",
				"caption": "Paste the id of any public agent"
			},
			{
				"expect": "Showing the agent you pasted"
			},
			{
				"scroll": 300,
				"ms": 900,
				"caption": "Its card, as a live element and as a plain image URL"
			},
			{
				"read": "name",
				"selector": "agent-glance .name",
				"match": "(.+)"
			},
			{
				"read": "metric",
				"selector": "agent-glance .metric",
				"match": "(moves today)"
			},
			{
				"hold": 2200
			},
			{
				"hover": {
					"selector": "#theme-select"
				},
				"caption": "Light, dark, or follow the reader's system"
			},
			{
				"press": "Tab"
			},
			{
				"press": "Tab"
			},
			{
				"press": "ArrowDown",
				"awaits": "/api/glance/card"
			},
			{
				"press": "ArrowDown",
				"awaits": "/api/glance/card"
			},
			{
				"read": "theme",
				"selector": "#snippet-html",
				"match": "theme=\"(\\w+)\""
			},
			{
				"hold": 2200
			},
			{
				"scroll": "Take it with you",
				"ms": 1000,
				"caption": "One line each for a page, a README, a terminal, and the API"
			},
			{
				"read": "cli",
				"selector": "#snippet-cli",
				"match": "(npx @three-ws/agent-glance)"
			},
			{
				"hold": 3200
			}
		]
	},
	"probes": [
		{
			"type": "scenario"
		}
	],
