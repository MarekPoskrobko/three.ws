	"kind": "post",
	"tier": 2,
	"lane": "developer",
	"pattern": "walkthrough",
	"notBefore": "2026-09-30T00:00:00Z",
	"covers": [
		"/glance",
		"@three-ws/agent-glance"
	],
	"scenario": {
		"format": "landscape",
		"steps": [
			{
				"goto": "https://three.ws/glance",
				"settle": 6000
			},
			{
				"hold": 1500,
				"caption": "Glance: an agent reduced to one card"
